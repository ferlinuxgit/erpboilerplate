# Required for local development, CI builds, migrations, and runtime.
# Use a non-secret CI/local database URL; do not commit real credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erpboilerplate

# Required for build/runtime. Generate a strong random JWT secret per environment.
JWT_SECRET=replace-with-a-random-secret-minimum-32-chars
APP_URL=http://localhost:3000

# Optional hardening/infrastructure.
LOG_LEVEL=info
SENTRY_DSN=
# Browser error reporting (optional). Usually the same DSN as SENTRY_DSN.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Rate limiting. With Upstash the limit is shared across instances; without it an
# in-memory per-instance limiter is used (never fails open; warns once in production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Number of trusted reverse proxies in front of the app (load balancer, CDN...).
# The client IP is the Nth entry from the RIGHT of X-Forwarded-For (fallback:
# x-real-ip). Used for the IP allowlist, rate limiting and session audit.
# 1 = a single proxy (default). 0 = no proxy: forwarding headers are ignored and
# the client IP is unknown (an IP allowlist then denies access).
TRUSTED_PROXY_COUNT=1

# Optional billing integration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_DEFAULT_STRIPE_PRICE_ID=

# Optional transactional email over SMTP.
# SMTP_HOST must match a hostname listed in the server's TLS certificate.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL="ERP <noreply@example.com>"

# Durable local fallback for OCR originals. In production, point this to a
# persistent volume or configure S3/R2 below.
LOCAL_UPLOAD_DIR=.data/uploads

# Optional S3/R2 object storage (recommended for production).
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# VeriFactu (RD 1007/2023). Sin transporte configurado los registros se generan
# y quedan "pendientes de envío". Worker: npm run verifactu:worker
VERIFACTU_ENVIRONMENT=test            # test (preproducción AEAT) | production
VERIFACTU_TRANSPORT=disabled          # disabled | aeat
VERIFACTU_CERT_PATH=                  # certificado cualificado .p12/.pfx (mTLS)
VERIFACTU_CERT_PASSWORD=
VERIFACTU_ENDPOINT_URL=               # opcional: sobrescribe la URL del servicio web
VERIFACTU_QR_BASE_URL=                # opcional: sobrescribe la URL de cotejo del QR
VERIFACTU_PRODUCER_NAME="ERP Suite"   # productor del software (declaración responsable)
VERIFACTU_PRODUCER_NIF=
VERIFACTU_SYSTEM_NAME="ERP Suite"
VERIFACTU_SYSTEM_ID=ES                # 2 caracteres
VERIFACTU_SYSTEM_VERSION=0.1.0
VERIFACTU_INSTALLATION_NUMBER=        # por defecto, el id de la empresa
VERIFACTU_WORKER_INTERVAL_MS=60000

# Facturas/gastos recurrentes y recordatorios de cobro automáticos (usan el SMTP de arriba).
# Worker continuo: npm run recurring:worker. Sin worker, llama al cron protegido
# GET/POST /api/recurring/run con la cabecera `x-cron-secret` o `Authorization: Bearer`.
CRON_SECRET=                          # mínimo 16 caracteres; vacío = cron desactivado
RECURRING_WORKER_INTERVAL_MS=900000   # 15 min (mínimo 60000)
RECURRING_WORKER_ONCE=false           # true = un solo ciclo y salir (cron del sistema)

# Workers arrancados junto a la app por scripts/docker-start.mjs (imagen Docker).
# Déjalos en false si los ejecutas en contenedores aparte.
OCR_WORKER_ENABLED=false
RECURRING_WORKER_ENABLED=false
VERIFACTU_WORKER_ENABLED=false
