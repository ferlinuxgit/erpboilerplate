# Required for local development, CI builds, migrations, and runtime.
# Use a non-secret CI/local database URL; do not commit real credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erpboilerplate

# Required for build/runtime. Generate a strong random JWT secret per environment.
JWT_SECRET=replace-with-a-random-secret-minimum-32-chars
APP_URL=http://localhost:3000

# Optional hardening/infrastructure.
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional billing integration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_DEFAULT_STRIPE_PRICE_ID=

# Optional transactional email over SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL="ERP <noreply@example.com>"

# Durable local fallback for OCR originals. In production, point this to a
# persistent volume or configure S3/R2 below.
LOCAL_UPLOAD_DIR=.data/uploads

# Optional S3/R2 object storage (recommended for production).
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
